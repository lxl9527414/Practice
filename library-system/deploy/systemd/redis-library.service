[Unit]
Description=Redis for Online Library Borrowing System
After=network.target

[Service]
Type=simple
User=redis
Group=redis
ExecStart=/opt/library/redis/bin/redis-server /opt/library/redis/redis.conf
ExecStop=/bin/kill -s TERM $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
